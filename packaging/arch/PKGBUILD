# Maintainer: Fjern contributors
pkgname=fjern-bin
pkgver=0.2.1
pkgrel=1
pkgdesc='Native Linux remote desktop client for RDP and VNC'
arch=('x86_64')
url='https://github.com/zeq0r/fjern'
license=('MIT' 'Apache-2.0' 'BSD-2-Clause' 'BSD-3-Clause' 'ISC' 'Unicode-3.0' 'Unlicense' 'Zlib')
options=('!debug')
provides=("fjern=$pkgver")
conflicts=('fjern')
depends=('brotli' 'gcc-libs' 'glibc' 'hicolor-icon-theme' 'libxkbcommon' 'openssl' 'wayland' 'zlib' 'zstd')
source=("fjern-v$pkgver-$CARCH-linux.tar.gz::$url/releases/download/v$pkgver/fjern-v$pkgver-$CARCH-linux.tar.gz")
sha256sums=('a07c6a70f7c2438efdc1efa77ccab7da352e8e612f9a462b7833228a84589e99')

package() {
  local bundle="$srcdir/fjern-v$pkgver-$CARCH-linux"
  install -Dm755 "$bundle/fjern" "$pkgdir/usr/bin/fjern"
  install -Dm644 "$bundle/fjern.desktop" "$pkgdir/usr/share/applications/fjern.desktop"
  install -Dm644 "$bundle/fjern.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/fjern.svg"
  install -Dm644 "$bundle/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  cp -r "$bundle/third-party-licenses" "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 "$bundle/README.md" "$pkgdir/usr/share/doc/fjern/README.md"
}
